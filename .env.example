# ============================================================
# Copy this file to ".env" and fill in your real values:
#     cp .env.example .env
# The .env file is gitignored — your secrets never leave your machine.
# ============================================================

# ---- Wallet (fill in EXACTLY ONE of these two) ----
# Option A: base58 private key exported from Phantom
# (Phantom: Settings -> Manage Accounts -> your account -> Show Private Key)
PRIVATE_KEY_BASE58=

# Option B: 12/24-word recovery phrase (derivation path m/44'/501'/0'/0')
# If BOTH are set, PRIVATE_KEY_BASE58 wins.
WALLET_MNEMONIC=

# ---- Helius RPC (free tier) ----
# Both URLs come from your Helius dashboard and include your api-key.
HELIUS_HTTPS_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY_HERE
HELIUS_WSS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY_HERE

# ---- Jupiter (portal.jup.ag, FREE tier = 1 request/second) ----
# The bot enforces ~1.1s between ALL Jupiter calls automatically.
JUPITER_API_KEY=

# ---- Wallets to copy-trade ----
# Comma-separated list of Solana wallet addresses to watch and mirror.
TRACKED_WALLETS=WalletAddress1,WalletAddress2

# ---- Safety switches ----
# DRY_RUN=true  -> fully simulated: real quotes, NO transactions ever sent.
# DRY_RUN=false -> REAL trades with REAL SOL. Only flip this after you've
#                  watched the bot behave correctly in dry-run mode.
DRY_RUN=true

# How much SOL to spend on each copied buy (a fixed amount per position;
# we do NOT mirror the tracked wallet's size).
COPY_BUY_AMOUNT_SOL=0.01

# Maximum simultaneous positions (open + stuck both count).
MAX_OPEN_POSITIONS=3

# Ignore tracked buys smaller than this (in SOL, or the USD equivalent
# when the tracked wallet paid with USDC/USDT). Filters out dust.
MIN_TRACKED_BUY_SOL=0.05

# In real mode, never spend down below this SOL balance (kept for fees/rent).
MIN_SOL_RESERVE=0.05

# Max slippage for our swaps, in basis points (300 = 3%).
SLIPPAGE_BPS=300

# How many Helius RPC reads per second the watcher may make. Busy wallets can
# emit several transactions a second; without this the bot floods the free tier
# with 429s and silently loses trades. Lower it if you still see retries,
# raise it if you're on a paid plan.
RPC_REQUESTS_PER_SECOND=8

# Desktop notifications on macOS when the bot buys, sells, or a sell fails.
# Set to false to turn them off.
NOTIFICATIONS=true

# Sounds on macOS: a DIFFERENT sound when a buy fills, when a sell completes,
# and when a sell FAILS (position stuck) — so you can tell what happened
# without looking. Independent of NOTIFICATIONS, and plays even when
# Notification Center is muted. Set to false to turn off.
SOUNDS=true

# Which sound for each event. A macOS system sound name (just the name, no
# .aiff):  Basso Blow Bottle Frog Funk Glass Hero Morse Ping Pop Purr Sosumi
# Submarine Tink — or the full path to your own file, starting with "/",
# e.g. /Users/you/Sounds/filled.mp3. Leave empty to keep the defaults.
SOUND_BUY=Glass
SOUND_SELL=Hero
SOUND_FAIL=Basso

# How often the P&L summary prints while the bot runs, in seconds. Applies in
# both DRY_RUN and real mode. Default 30. Cheap even at short intervals — this
# periodic print is never marked to market, so it costs no Jupiter calls.
SUMMARY_INTERVAL_SECONDS=30
