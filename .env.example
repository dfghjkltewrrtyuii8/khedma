# ============================================================
# Easiest: run `npm run setup` — it asks for each value, checks it, and
# writes .env for you.
# Manual alternative: copy this file to .env ONCE and fill it in:
#     cp -n .env.example .env      (-n = never overwrite an existing .env)
# The .env file is gitignored — your secrets never leave your machine.
# ============================================================

# ---- Wallet (fill in EXACTLY ONE of these two) ----
# Option A: base58 private key exported from Phantom
# (Phantom: Settings -> Manage Accounts -> your account -> Show Private Key)
PRIVATE_KEY_BASE58=

# Option B: 12/24-word recovery phrase (derivation path m/44'/501'/0'/0')
# If BOTH are set, PRIVATE_KEY_BASE58 wins.
WALLET_MNEMONIC=

# ---- Helius RPC (free tier) ----
# Both URLs come from your Helius dashboard and include your api-key.
HELIUS_HTTPS_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY_HERE
HELIUS_WSS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY_HERE

# ---- Jupiter (portal.jup.ag, FREE tier = 1 request/second) ----
# The bot enforces ~1.1s between ALL Jupiter calls automatically.
JUPITER_API_KEY=

# ---- Wallets to copy-trade ----
# Comma-separated list of Solana wallet addresses to watch and mirror.
TRACKED_WALLETS=WalletAddress1,WalletAddress2

# ---- Safety switches ----
# DRY_RUN=true  -> fully simulated: real quotes, NO transactions ever sent.
# DRY_RUN=false -> REAL trades with REAL SOL. Only flip this after you've
#                  watched the bot behave correctly in dry-run mode.
DRY_RUN=true

# How much SOL to spend on each copied buy (a fixed amount per position;
# we do NOT mirror the tracked wallet's size).
COPY_BUY_AMOUNT_SOL=0.01

# Maximum simultaneous positions (open + stuck both count).
MAX_OPEN_POSITIONS=3

# Ignore tracked buys smaller than this (in SOL, or the USD equivalent
# when the tracked wallet paid with USDC/USDT). Filters out dust.
MIN_TRACKED_BUY_SOL=0.05

# In real mode, never spend down below this SOL balance (kept for fees/rent).
MIN_SOL_RESERVE=0.05

# Max slippage for our swaps, in basis points (300 = 3%).
SLIPPAGE_BPS=300

# ---- Quality gates (what NOT to copy) ----
# Every real loss so far was a token minutes old with thin liquidity: by the
# time the copy landed, the entry was the top and the exit found no depth.
# Before copying any buy, the bot checks the token on Dexscreener (free, no
# key, separate from the Jupiter budget). A token with no market data yet is
# treated as too new and skipped. Set BOTH to 0 to turn the check off.
MIN_TOKEN_AGE_MINUTES=30
MIN_LIQUIDITY_USD=20000

# A tracked wallet whose copied positions close at a loss this many times in
# a row is MUTED: its new buys are skipped (its open positions are still
# mirrored on sell). 0 = never mute.
WALLET_MAX_CONSECUTIVE_LOSSES=3

# How long a muted wallet stays muted before it gets one more chance.
# 0 = stays muted until you remove it from TRACKED_WALLETS.
WALLET_MUTE_HOURS=24

# The watcher on a free Helius plan drops trades past a handful of busy
# wallets (measured: 27% of signals lost at 6), and dropped trades make every
# result meaningless. The bot refuses to start with more than this many.
# Raise it only on a paid plan.
MAX_TRACKED_WALLETS=6

# ---- Wallet rotation (optional) ----
# Substitutes. Put extra candidate wallets here and the bot copies
# TRACKED_WALLETS-many of them at a time, swapping out the ones that aren't
# working. It never adds a wallet that isn't in TRACKED_WALLETS or here.
# Leave empty to keep a fixed list.
BENCH_WALLETS=

# Drop a wallet for good once this many of its copies have closed with a net
# loss (the losing-streak rule above drops it too). 0 = only the streak.
WALLET_DROP_AFTER_TRADES=6

# Send a wallet to the back of the bench after this many minutes without a
# buy while the bot is running. It gets another turn later. 0 = never.
WALLET_IDLE_MINUTES=90

# Automatic wallet discovery. When the bench runs low, the bot looks at
# tokens trending right now (GeckoTerminal's free API) and finds wallets that
# bought AFTER the launch rush, held a while, and sold at a profit — ideally
# on more than one token. New finds go to the back of the bench and are
# copied on PAPER until they've proven themselves (6 closed paper copies in
# profit), even when DRY_RUN=false. Turning this on also turns on rotation.
# Try it by hand first: npm run discover
DISCOVERY=false

# ---- Exits on YOUR terms, not the tracked wallet's ----
# Without these the bot only sells when the wallet it copied sells — so you
# ride their timing down, plus the 5-15s it takes to see and act on it. That
# is how a position closed at -78%. Percentages are of what you paid.
#
# Sell if the position falls this far. 0 = off.
STOP_LOSS_PERCENT=30

# Sell if a position that HAS been in profit gives back this much from its
# own peak. Lets a big winner keep running while protecting the gain. 0 = off.
TRAILING_STOP_PERCENT=30

# Sell as soon as a position is up this much. OFF by default on purpose:
# this strategy's returns come from rare outliers (in dry-run, 8 losers were
# carried by a single +984%), and capping the upside is how you make sure the
# winner can never pay for the losers. Use TRAILING_STOP_PERCENT instead.
TAKE_PROFIT_PERCENT=0

# How often to price open positions to check those rules. Each check costs
# one Jupiter request (~1.1s) per open position, so a trade arriving mid-
# check waits a little longer. Raise this if you'd rather have the
# responsiveness. Costs nothing when all three rules above are 0.
EXIT_CHECK_SECONDS=30

# After one of the rules above sells a token, ignore new buys of that same
# token for this many hours — otherwise the next buy from the tracked wallet
# puts you straight back into what you just escaped. 0 = allow immediately.
EXIT_REBUY_COOLDOWN_HOURS=24

# How many Helius RPC reads per second the watcher may make. Busy wallets can
# emit several transactions a second; without this the bot floods the free tier
# with 429s and silently loses trades. Lower it if you still see retries,
# raise it if you're on a paid plan.
RPC_REQUESTS_PER_SECOND=8

# Desktop notifications on macOS when the bot buys, sells, or a sell fails.
# Set to false to turn them off.
NOTIFICATIONS=true

# Sounds on macOS: a DIFFERENT sound when a buy fills, when a sell completes,
# and when a sell FAILS (position stuck) — so you can tell what happened
# without looking. Independent of NOTIFICATIONS, and plays even when
# Notification Center is muted. Set to false to turn off.
SOUNDS=true

# Which sound for each event. A macOS system sound name (just the name, no
# .aiff):  Basso Blow Bottle Frog Funk Glass Hero Morse Ping Pop Purr Sosumi
# Submarine Tink — or the full path to your own file, starting with "/",
# e.g. /Users/you/Sounds/filled.mp3. Leave empty to keep the defaults.
SOUND_BUY=Glass
SOUND_SELL=Hero
SOUND_FAIL=Basso

# Spoken alerts on macOS: the Mac SAYS what happened, right after the chime.
# Dry-run trades are spoken as "Simulated. Order filled." so paper can never
# be mistaken for real money. Set SPEECH=false for chimes only.
# Hear them all without waiting for a trade:  npm run alerts
SPEECH=true
SPEECH_BUY=Order filled
SPEECH_SELL=Order sold
SPEECH_FAIL=Sell failed. Position stuck.

# Optional. Voice name (see them with: say -v "?") and speed in words per
# minute (80-500; normal is about 175). Leave empty for your Mac's default.
SPEECH_VOICE=
SPEECH_RATE=

# How often the P&L summary prints while the bot runs, in seconds. Applies in
# both DRY_RUN and real mode. Default 30. Cheap even at short intervals — this
# periodic print is never marked to market, so it costs no Jupiter calls.
SUMMARY_INTERVAL_SECONDS=30
