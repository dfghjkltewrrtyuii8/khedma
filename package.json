{
  "name": "khedma-copy-trader",
  "version": "1.3.0",
  "private": true,
  "description": "Solana copy-trading bot: watches chosen wallets and mirrors their buys/sells via Jupiter Swap API v2",
  "scripts": {
    "start": "NODE_OPTIONS=--no-deprecation tsx src/index.ts",
    "setup": "NODE_OPTIONS=--no-deprecation tsx src/setup.ts",
    "doctor": "NODE_OPTIONS=--no-deprecation tsx src/doctor.ts",
    "alerts": "NODE_OPTIONS=--no-deprecation tsx src/alerts.ts",
    "summary": "NODE_OPTIONS=--no-deprecation tsx src/summary.ts",
    "writeoff": "NODE_OPTIONS=--no-deprecation tsx src/writeoff.ts",
    "test": "tsx test/logic-test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.0",
    "bip39": "^3.1.0",
    "bs58": "^5.0.0",
    "dotenv": "^16.4.5",
    "ed25519-hd-key": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
