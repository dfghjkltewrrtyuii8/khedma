{
  "name": "khedma-copy-trader",
  "version": "1.9.5",
  "private": true,
  "description": "Solana copy-trading bot: watches chosen wallets and mirrors their buys/sells via Jupiter Swap API v2",
  "scripts": {
    "start": "tsx --no-deprecation src/index.ts",
    "setup": "tsx --no-deprecation src/setup.ts",
    "doctor": "tsx --no-deprecation src/doctor.ts",
    "alerts": "tsx --no-deprecation src/alerts.ts",
    "summary": "tsx --no-deprecation src/summary.ts",
    "discover": "tsx --no-deprecation src/discover.ts",
    "writeoff": "tsx --no-deprecation src/writeoff.ts",
    "telegram": "tsx --no-deprecation src/telegramSetup.ts",
    "recommended": "tsx --no-deprecation src/recommended.ts",
    "test": "tsx test/logic-test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@solana/web3.js": "^1.99.0",
    "bip39": "^3.1.0",
    "bs58": "^5.0.0",
    "dotenv": "^16.4.5",
    "ed25519-hd-key": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
